# CI secrets; never put credentials in PUBLIC_* variables.
GITHUB_TOKEN=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional public verification/analytics values.
PUBLIC_SEARCH_CONSOLE_VERIFICATION=
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://a.awesome.pawel.in
# Optional dashboard host (defaults to US Cloud).
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Enable masked session replay in production (samples 10% by default).
PUBLIC_POSTHOG_REPLAY_ENABLED=true
SITE_URL=https://awesome.pawel.in
PRODUCTION=false

# PostHog captures in production when the token and host above are set.
# Optional kill switch; rebuild/redeploy after changing it.
# ANALYTICS_ENABLED=false
