---
import { categoryName, compact, type Resource } from '../lib/catalog';
interface Props { resource: Resource; order?: number }
const { resource: r } = Astro.props;
---
<article
  class="resource-card group py-4 px-0 [.directory[data-view=grid]_&]:border [.directory[data-view=grid]_&]:border-[#20232a] [.directory[data-view=grid]_&]:rounded-xl [.directory[data-view=grid]_&]:p-4 md:[.directory[data-view=grid]_&]:p-5 [.directory[data-view=grid]_&]:hover:border-neutral-700 [.directory[data-view=grid]_&]:bg-[#14161a] transition-all grid grid-cols-[1fr_auto] grid-rows-[auto_auto] items-center gap-x-4 gap-y-2"
  data-resource
  data-name={r.name.toLowerCase()}
  data-description={r.description.toLowerCase()}
  data-category={r.categories.join(',')}
  data-type={r.type}
  data-technology={r.technologies.join(',')}
  data-level={r.level}
  data-stars={r.metrics?.stars ?? -1}
>
  <!-- Row 1, Column 1: Title and Owner -->
  <div class="flex items-baseline gap-2 min-w-0 overflow-hidden">
    <h3 class="text-base font-bold text-white tracking-tight truncate">
      <a href={r.path} class="hover:underline hover:text-white">
        {r.name}
        {r.name === 'Go' && <span class="sr-only"> programming resources</span>}
      </a>
    </h3>
    <span class="text-xs md:text-sm text-neutral-400 font-normal shrink-0">{r.owner}</span>
  </div>

  <!-- Row 1, Column 2: Stars and External Link -->
  <div class="flex items-center gap-2 shrink-0 justify-self-end">
    {r.metrics && (
      <span
        class="star-count inline-flex items-center gap-1 text-xs md:text-sm text-neutral-300 font-medium"
        title={`${r.metrics.stars.toLocaleString()} stars; ${r.metrics.forks.toLocaleString()} forks; checked ${r.metrics.fetchedAt.slice(0, 10)}`}
        data-metrics
      >
        <span class="text-neutral-400 text-xs">★</span>
        <span>{compact(r.metrics.stars)}</span>
      </span>
    )}
    <a
      class="card-source text-neutral-400 hover:text-white transition-colors text-sm px-1"
      href={r.url}
      aria-label={`View ${r.name} on GitHub`}
      title="Open source repository"
    >
      <span class="text-xs">↗</span>
    </a>
  </div>

  <!-- Row 2, Column 1: Description -->
  <div class="min-w-0 overflow-hidden">
    <p class="text-xs md:text-sm text-neutral-400 font-normal line-clamp-1 leading-relaxed truncate mb-0">
      {r.description}
    </p>
  </div>

  <!-- Row 2, Column 2: Category badge (license pill removed) -->
  <div class="shrink-0 flex items-center justify-self-end">
    <a
      class="badge badge-sm rounded bg-[#181d27] border border-[#2b3547] text-neutral-300 px-2.5 py-1 text-[11px] font-normal hover:border-neutral-500 hover:text-white"
      href={`/categories/${r.categories[0]}/`}
    >
      {categoryName(r.categories[0])}
      {categoryName(r.categories[0]) === 'Go' && <span class="sr-only"> programming</span>}
    </a>
    {r.type && r.type !== 'unclassified' && (
      <span class="sr-only">{r.type}</span>
    )}
  </div>
</article>
