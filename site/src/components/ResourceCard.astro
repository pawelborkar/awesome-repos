---
import { categoryName,compact,type Resource } from '../lib/catalog';
import Icon from './Icon.astro';
interface Props {resource: Resource; order?:number}
const {resource:r}=Astro.props;
---
<article class="resource-card" data-resource data-name={r.name.toLowerCase()} data-description={r.description.toLowerCase()} data-category={r.categories.join(',')} data-type={r.type} data-technology={r.technologies.join(',')} data-level={r.level} data-stars={r.metrics?.stars ?? -1}>
  <span class="repo-icon"><Icon name={r.journey==='learn'?'book':'repo'} size={20}/></span>
  <div class="card-content"><div class="card-title"><h3><a href={r.path}>{r.name}{r.name==='Go'&&<span class="screen-reader-only"> programming resources</span>}</a></h3><span class="card-owner">{r.owner}</span></div><p>{r.description}</p><div class="card-bottom"><a class="tag" href={`/categories/${r.categories[0]}/`}>{categoryName(r.categories[0])}{categoryName(r.categories[0])==='Go'&&<span class="screen-reader-only"> programming</span>}</a>{r.type!=='unclassified'&&<span class="format-tag">{r.type}</span>}<span class="card-license">{r.licenses.map(l=>l.name).join(' / ')}</span></div></div>
  <div class="card-trailing">{r.metrics&&<span class="star-count" title={`${r.metrics.stars.toLocaleString()} stars; ${r.metrics.forks.toLocaleString()} forks; checked ${r.metrics.fetchedAt.slice(0,10)}`} data-metrics><Icon name="star" size={14}/>{compact(r.metrics.stars)}</span>}<a class="card-source" href={r.url} aria-label={`View ${r.name} on GitHub`} title="Open source repository"><Icon name="arrow" size={16}/></a></div>
</article>
