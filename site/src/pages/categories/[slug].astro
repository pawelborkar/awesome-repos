---
import Layout from '../../layouts/Layout.astro';
import ResourceList from '../../components/ResourceList.astro';
import {categories,resources,collections} from '../../lib/catalog';
import {collectionPage} from '../../lib/seo';
export function getStaticPaths(){return categories.map(c=>({params:{slug:c.slug},props:{category:c}}));}
const {category}=Astro.props;
const selected=resources.filter(r=>r.categories.includes(category.slug));
const curated=collections.filter(c=>c.indexable&&c.resources.some(k=>selected.some(r=>r.key===k)));
const editorial=category.editorial;
const indexable=!!(editorial?.reviewed && selected.length>=5);
---
<Layout
  title={editorial?.title || `${category.name} repositories and resources`}
  description={`Explore ${selected.length} curated ${category.name} repositories, with source links, license information, and related learning resources and developer tools.`}
  indexable={indexable}
  breadcrumbs={[{ name: 'Categories', path: '/categories/' }, { name: category.name, path: `/categories/${category.slug}/` }]}
  schema={{ ...collectionPage(category.name, selected), ...(editorial?.reviewed ? { lastReviewed: editorial.updated } : {}) }}
>
  <div class="flex flex-col gap-6">
    <header class="page-heading flex flex-col gap-2 pt-2">
      <div class="eyebrow text-[11px] font-semibold text-neutral-400 tracking-wider font-mono uppercase">EXPLORE / {category.name.toUpperCase()}</div>
      <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">{category.name}</h1>
      <p class="text-sm text-neutral-400 mt-1 font-normal leading-relaxed max-w-2xl">Explore {selected.length} curated {category.name} repositories and developer resources.</p>
    </header>

    {editorial?.reviewed && (
      <article class="prose max-w-none text-neutral-300 text-sm leading-relaxed space-y-3 border border-[#20232a] bg-[#14161a] p-5 rounded-xl">
        <p>{editorial.intro}</p>
        <h2 id="selection" class="text-base font-bold text-white tracking-tight">Choose a useful starting point</h2>
        <p class="text-neutral-400">{editorial.selection}</p>
        <p class="text-xs text-neutral-500 font-mono">Selection notes updated <time datetime={editorial.updated}>{editorial.updated}</time>.</p>
      </article>
    )}

    {curated.length > 0 && (
      <section class="border border-[#20232a] bg-[#14161a] p-5 rounded-xl">
        <h2 class="text-base font-bold text-white tracking-tight mb-3">Looking for a starting point?</h2>
        <ul class="space-y-2 text-sm">
          {curated.slice(0, 3).map(c => (
            <li class="text-neutral-400">
              <a href={`/discover/${c.slug}/`} class="text-white hover:underline font-medium">{c.title}</a> — {c.description}
            </li>
          ))}
        </ul>
      </section>
    )}

    <ResourceList resources={selected}/>
  </div>
</Layout>
