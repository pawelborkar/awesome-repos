---
import Layout from '../../layouts/Layout.astro';
import Action from '../../components/Action.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import {resources,categoryName,compact} from '../../lib/catalog';
export function getStaticPaths(){return resources.map(resource=>({params:{repo:resource.key},props:{resource}}));}
const {resource:r}=Astro.props;
const a=r.annotation;
const related=resources.filter(x=>x.key!==r.key && x.categories.some(c=>r.categories.includes(c))).slice(0,3);
---
<Layout title={`${r.name} (${r.owner}/${r.repository}): overview`} description={r.description.slice(0,155)} indexable={r.indexable} breadcrumbs={[{name:categoryName(r.categories[0]),path:`/categories/${r.categories[0]}/`},{name:r.name,path:r.path}]} schema={{'@type':'WebPage',name:r.name,about:{'@type':'CreativeWork',name:r.name,url:r.url},url:`https://awesome.pawel.in${r.path}`}}>
<header class="page-heading"><div class="eyebrow">{r.owner} / {r.repository}</div><h1 data-pagefind-body>{r.name}</h1><p data-pagefind-body>{r.description}</p><Action href={r.url} variant="primary" size="md">Explore on GitHub <span aria-hidden="true">↗</span></Action></header>
<div class="detail-layout"><article class="prose" data-pagefind-body>
{a?.reviewed ? <><h2>Who it is for</h2><p>{a.audience}</p><h2>What you can do with it</h2><p>{a.value}</p><h2>Before you start</h2><p>{a.limitations}</p><h2>Source and context</h2><p>These selection notes describe the resource's scope. Check the source for current details.</p><ul>{a.sources.map(url=><li><a href={url}>{new URL(url).hostname}{new URL(url).pathname}</a></li>)}</ul><p>Selection notes updated <time datetime={a.updated}>{a.updated}</time>.</p></> : <><h2>Explore the source</h2><p>This repository is part of the community-maintained Awesome Repositories catalog. Its description and license information come from the catalog README.</p><p>Visit the repository to check its documentation, examples, requirements, and current status before choosing it for your project or learning plan.</p><h2>Help others find their starting point</h2><p>Used this resource? <a href="/contribute/">Contribute selection notes</a> about who it helps and what to expect.</p></>}
</article><aside class="detail-sidebar" aria-label="Resource information"><h2>At a glance</h2><dl><dt>Categories</dt><dd>{r.categories.map((c,i)=><>{i>0?' · ':''}<a href={`/categories/${c}/`}>{categoryName(c)}</a></>)}</dd><dt>Format</dt><dd>{r.type==='unclassified'?'Not yet classified':r.type}</dd><dt>Experience level</dt><dd>{r.level==='unclassified'?'Not yet classified':r.level.replaceAll('-',' ')}</dd>{r.technologies.length>0&&<><dt>Technologies</dt><dd>{r.technologies.join(', ')}</dd></>}<dt>License</dt><dd>{r.licenses.map((l,i)=><>{i>0?' / ':''}{l.url?<a href={l.url}>{l.name}</a>:l.name}</>)}</dd>{r.metrics && <><dt>GitHub popularity</dt><dd data-metrics>☆ {compact(r.metrics.stars)} stars · ⑂ {compact(r.metrics.forks)} forks</dd><dt>Metrics checked</dt><dd data-metrics><time datetime={r.metrics.fetchedAt}>{r.metrics.fetchedAt.slice(0,10)}</time></dd></>}<dt>Source</dt><dd><a href={r.url}>{r.owner}/{r.repository}</a></dd></dl></aside></div>
<section class="section-spaced"><div class="section-heading"><h2>Keep exploring</h2><a href={`/categories/${r.categories[0]}/`}>Explore the category →</a></div><div class="resource-grid">{related.map(resource=><ResourceCard resource={resource}/>)}</div></section><div class="section-spaced"></div>
<meta data-pagefind-meta="title[content]" content={r.name}/>{r.categories.map(c=><meta data-pagefind-filter={`category:${categoryName(c)}`}/>)}<span data-pagefind-filter={`type:${r.type}`}></span><span data-pagefind-filter={`level:${r.level}`}></span>{r.technologies.map(t=><span data-pagefind-filter={`technology:${t}`}></span>)}<meta data-pagefind-sort="name[content]" content={r.name.toLowerCase()}/><meta data-pagefind-sort="stars[content]" content={String(r.metrics?.stars??-1)}/>
</Layout>
