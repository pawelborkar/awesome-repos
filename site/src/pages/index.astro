---
import Layout from '../layouts/Layout.astro';
import ResourceList from '../components/ResourceList.astro';
import Icon from '../components/Icon.astro';
import {resources,categories,collections} from '../lib/catalog';
const lastChecked=resources.map(r=>r.metrics?.fetchedAt||'').sort().at(-1);
---
<Layout title="Curated repositories for learning and building" description="A searchable library of curated GitHub repositories. Find programming courses, books, developer tools, frameworks, and practical projects.">
  <header class="library-heading"><div><div class="eyebrow">YOUR NEXT STARTING POINT</div><h1>All repositories</h1><p>A considered collection of resources for learning and building.<br class="desktop-break"/> Find something useful. Make something of your own.</p></div><a class="source-button" href="https://github.com/pawelborkar/awesome-repos"><Icon name="github" size={16}/><span>Star on GitHub</span><Icon name="arrow" size={14}/></a></header>
  <div class="library-overview"><span><strong>{resources.length}</strong> repositories</span><span><strong>{categories.length}</strong> topics</span><span><strong>{collections.length}</strong> curated collections</span>{lastChecked&&<span class="snapshot-status"><span class="status-dot"></span>Metrics checked <time datetime={lastChecked}>{lastChecked.slice(0,10)}</time></span>}</div>
  <nav class="library-tabs" aria-label="Resource journeys"><a href="/" aria-current="page">Everything <span>{resources.length}</span></a><a href="/learn/">Learning resources</a><a href="/tools/">Developer tools</a><a href="/discover/">Curated collections</a></nav>
  <ResourceList resources={resources}/>
</Layout>
